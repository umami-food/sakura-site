---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CourseRow from '../components/CourseRow.astro';
import menu from '../data/menu.json';
import drinks from '../data/drinks.json';
import { t, pick, yen, withBase, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const order = ['standard', 'tabehoudai', 'unkai'];
const labels = d.categories as Record<string, string>;
const groupText = (d.menu as any).groups as Record<string, string>;
const groups = order
  .map((c) => ({ id: c, items: menu.items.filter((i) => i.category === c) }))
  .filter((g) => g.items.length > 0);
---
<Base lang={lang} page="menu" title={d.seo.menu.title} description={d.seo.menu.description}>
  <PageHead title={d.menu.title} lead={d.menu.lead} />
  <section class="section">
    <div class="wrap">
      <div class="filter menu-tabs" data-filter hidden role="group" aria-label={d.menu.title}>
        <button type="button" data-value="all" aria-pressed="true">{d.ui.all}</button>
        {groups.map((g) => <button type="button" data-value={g.id} aria-pressed="false">{labels[g.id]}<span class="tab-count">{g.items.length}</span></button>)}
        <button type="button" data-value="drink" aria-pressed="false">{labels.drink}</button>
      </div>
      {groups.map((g) => (
        <section class="menu-group" id={g.id} data-cat={g.id} aria-labelledby={`${g.id}-title`}>
          <div class="menu-group-head">
            <h2 id={`${g.id}-title`}>{labels[g.id]}</h2>
            <p>{groupText[g.id]}</p>
          </div>
          <ul class="course-list">
            {g.items.map((item) => <CourseRow item={item} lang={lang} />)}
          </ul>
        </section>
      ))}
      <section class="menu-group" id="drink" data-cat="drink" aria-labelledby="drink-title">
        <div class="menu-group-head">
          <h2 id="drink-title">{(d as any).drink.title}</h2>
          <p>{(d as any).drink.lead}</p>
        </div>
        <div class="drink-highlights">
          {drinks.highlights.map((h: any) => <div>{h.image && <img src={withBase('images/' + h.image)} alt={pick(h.title, lang)} width="1200" height="900" loading="lazy" decoding="async" />}<div class="dh-body"><h3>{pick(h.title, lang)}</h3><p>{pick(h.body, lang)}</p></div></div>)}
        </div>
        <h3 class="drink-plans-title">{(d as any).drink.plansTitle}</h3>
        <ul class="course-list drink-plans">
          {drinks.plans.map((pl: any) => (
            <li class="course drink-plan">
              <div>
                <h3>{pl.badge && <span class="course-badge">{pick(pl.badge, lang)}</span>}<span class={`plan-tag tag-${pl.tag}`}>{pl.tag}</span>{pick(pl.name, lang)}</h3>
                <p>{pick(pl.desc, lang)}</p>
                <p class="plan-includes">{pick(pl.includes, lang)}</p>
              </div>
              <p class="price"><strong>{yen(pl.price)}</strong><small>{d.ui.taxIncl}</small></p>
            </li>
          ))}
        </ul>
        <p class="drink-rules">{(d as any).drink.rules}</p>

        <h3 class="drink-plans-title drink-list-title">{(d as any).drink.listTitle}</h3>
        <p class="drink-legend">{(d as any).drink.legend}</p>
        <div class="drink-list">
          {drinks.categories.map((c: any) => (
            <section class="drink-cat">
              <h4><span class={`plan-tag tag-${c.plan}`}>{c.plan}</span>{pick(c.title, lang)}</h4>
              {c.note && <p class="drink-cat-note">{pick(c.note, lang)}</p>}
              <ul>
                {c.items.map((i: any) => (
                  <li><span class="dn">{pick(i.name, lang)}</span><span class="dp">{yen(i.price)}{i.from ? (d as any).drink.from_ : ''}</span></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="muted drink-tax">{(d as any).drink.taxNote}</p>
      </section>
      <p class="muted" style="margin-top:1.5rem">{d.menu.note}</p>
    </div>
  </section>
</Base>
